# Example snippet: place inside the licenca.brendigo.com server block
# after enabling PHP-FPM and HTTPS, BEFORE the generic PHP location.
# Root should point at the public directory containing /licenca/.
location ^~ /licenca/private/ { return 404; }
location ^~ /licenca/bin/ { return 404; }
location ^~ /licenca/tests/ { return 404; }
location = /licenca/api.php {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_param HTTPS on;
    fastcgi_pass unix:/run/php/php8.3-fpm.sock; # replace with YOUR PHP-FPM socket
}
location ~ ^/licenca/ {
    return 404;
}
